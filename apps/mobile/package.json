{
  "name": "@cordeau/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "build": "echo 'Mobile build via EAS: eas build --profile preview'"
  },
  "jest": {
    "projects": [
      {
        "displayName": "expo",
        "preset": "jest-expo",
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|drizzle-orm)"
        ],
        "moduleNameMapper": {
          "@cordeau/shared": "<rootDir>/../../packages/shared/src/index.ts",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "\\.node\\.test\\."
        ]
      },
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "**/*.node.test.[jt]s?(x)"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(drizzle-orm)/)"
        ],
        "moduleNameMapper": {
          "@cordeau/shared": "<rootDir>/../../packages/shared/src/index.ts",
          "^@/(.*)$": "<rootDir>/$1"
        }
      }
    ]
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.8",
    "expo-auth-session": "~56.0.13",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "^56.0.7",
    "expo-font": "~56.0.5",
    "expo-image-picker": "^56.0.16",
    "expo-linking": "~56.0.9",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.9",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.35.0",
    "nativewind": "~4.2.6",
    "react": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-native": "0.87.1",
    "react-native-image-viewing": "^0.2.2",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "~15.15.5",
    "react-native-worklets": "0.12.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.8",
    "sql.js": "^1.14.2",
    "typescript": "~5.9.2"
  }
}
