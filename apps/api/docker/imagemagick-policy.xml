<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)+>
<!ATTLIST policymap xmlns CDATA #FIXED ''>
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
  name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
  stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  Durcissement ImageMagick pour Cordeau — cf docs/adr/0023-traitement-image-imagick-heic.md

  ImageMagick traite des fichiers fournis par l'utilisateur (photos). Cette policy
  réduit la surface d'attaque (CVE type ImageTragick : RCE/SSRF/LFI via coders, bombes
  de décompression) :
    - tous les delegates externes désactivés (ghostscript, ffmpeg, url...),
    - tous les coders refusés par défaut, seul le raster attendu autorisé,
    - lectures indirectes (@fichier) interdites,
    - limites de ressources contre les bombes de décompression.
-->
<policymap>
  <!-- Aucun delegate externe (https/url/ghostscript/ffmpeg...) -->
  <policy domain="delegate" rights="none" pattern="*" />

  <!-- Lectures indirectes interdites : @liste-de-fichiers -->
  <policy domain="path" rights="none" pattern="@*" />

  <!-- Tous les coders refusés, puis liste blanche du raster attendu -->
  <policy domain="coder" rights="none" pattern="*" />
  <policy domain="coder" rights="read|write" pattern="{JPEG,JPG,PNG,WEBP,HEIC,HEIF,GIF}" />

  <!-- Limites de ressources (anti decompression bomb / DoS) -->
  <policy domain="resource" name="memory" value="256MiB" />
  <policy domain="resource" name="map" value="512MiB" />
  <policy domain="resource" name="area" value="128MP" />
  <policy domain="resource" name="width" value="16KP" />
  <policy domain="resource" name="height" value="16KP" />
  <policy domain="resource" name="disk" value="1GiB" />
  <policy domain="resource" name="time" value="30" />

  <!-- Modules désactivés en plus, par prudence -->
  <policy domain="module" rights="none" pattern="{PS,PS2,PS3,EPS,PDF,XPS,MSL,MVG,SVG,URL,HTTPS,HTTP,FTP,EPHEMERAL,LABEL,TEXT,SHOW,WIN,CAPTION}" />
</policymap>
